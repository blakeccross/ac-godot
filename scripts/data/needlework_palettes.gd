## Palette index (0-15, masked) -> 16 opaque Colors, in CI order.
static func colors(palette_idx: int) -> PackedColorArray:
	var row: Array = RAW[palette_idx & 15]
	var out := PackedColorArray()
	out.resize(COLOR_COUNT)
	for i in COLOR_COUNT:
		var v: int = int(row[i])
		out[i] = Color8((v >> 16) & 0xFF, (v >> 8) & 0xFF, v & 0xFF, 255)
	return out


## Single colour lookup.
static func color_at(palette_idx: int, ci: int) -> Color:
	var v: int = int(RAW[palette_idx & 15][ci & 15])
	return Color8((v >> 16) & 0xFF, (v >> 8) & 0xFF, v & 0xFF, 255)
