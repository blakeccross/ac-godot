{
  "id": "rover_intro",
  "speaker_id": "rover",
  "start": "greet",
  "nodes": {
    "greet": {
      "type": "line",
      "text": "Hrmm… Uh… Excuse me…\nDo you have a second?",
      "next": "greet_clock"
    },
    "greet_clock": {
      "type": "line",
      "text": "Could you help me out?\nIs it… Let's see now…\n{hour}:{minute} {ampm} on {weekday},\n{month} {day}, {year}?",
      "next": "clock_choice"
    },
    "clock_choice": {
      "type": "choice",
      "options": [
        {
          "text": "That's right!",
          "goto": "clock_ok"
        },
        {
          "text": "That's wrong!",
          "goto": "clock_wrong"
        }
      ]
    },
    "clock_wrong": {
      "type": "line",
      "text": "Whaaat??? It's not?\n\nWell, do you think you could\nstraighten this out for me?",
      "next": "clock_prompt",
      "events": [
        {
          "op": "manpu",
          "name": "gaaan1"
        }
      ]
    },
    "clock_prompt": {
      "type": "event",
      "events": [
        {
          "op": "prompt_clock"
        }
      ],
      "next": "clock_confirm"
    },
    "clock_confirm": {
      "type": "line",
      "text": "Now, let me get this straight.\nYou say it's {hour}:{minute} {ampm}\non {month} {day}, {year}?",
      "next": "clock_confirm_sure"
    },
    "clock_confirm_sure": {
      "type": "line",
      "text": "You're sure?",
      "next": "clock_confirm_choice"
    },
    "clock_confirm_choice": {
      "type": "choice",
      "options": [
        {
          "text": "Perfect!",
          "goto": "clock_ok"
        },
        {
          "text": "No! No! No!",
          "goto": "clock_reject"
        }
      ]
    },
    "clock_reject": {
      "type": "line",
      "text": "What? What was that again?\nI think I heard you wrong.\n\nTell me once more.",
      "next": "clock_prompt",
      "events": [
        {
          "op": "manpu",
          "name": "hate1"
        }
      ]
    },
    "clock_ok": {
      "type": "line",
      "text": "Say, thanks! You're too kind!\nReally, you're a big help…\nMya ha ha ha ha howr!",
      "next": "greet_sit",
      "events": [
        {
          "op": "manpu",
          "name": "smile1"
        }
      ]
    },
    "greet_sit": {
      "type": "line",
      "text": "So, you mind if I sit here?\nI promise I won't fall asleep,\ntumble onto you, and start\ndrooling on your shirt!",
      "next": "greet_choice"
    },
    "greet_choice": {
      "type": "choice",
      "options": [
        {
          "text": "Please!",
          "goto": "sit_yes",
          "events": [
            {
              "op": "or_var",
              "name": "answer_flags",
              "mask": 8
            }
          ]
        },
        {
          "text": "No way!",
          "goto": "sit_no"
        }
      ]
    },
    "sit_yes": {
      "type": "line",
      "text": "Thanks again! It sure is nice\nmeeting friendly folk on the\ntrain… You aren't a psycho,\nright? Just kidding!",
      "next": "sit_yes_2"
    },
    "sit_yes_2": {
      "type": "line",
      "text": "Say, by the way…\nwhat's your name?",
      "next": "sit_stage"
    },
    "sit_no": {
      "type": "line",
      "text": "Wow, it's nice to know there\nare still plenty of rude people\nin the world. Know what?\nI'm going to sit here anyway.",
      "next": "sit_no_2",
      "events": [
        {
          "op": "manpu",
          "name": "niko_d1"
        }
      ]
    },
    "sit_no_2": {
      "type": "line",
      "text": "I don't even know why I'm\nbothering to ask this, but\nwhat's your name?",
      "next": "sit_stage",
      "events": [
        {
          "op": "manpu",
          "name": "reset_sit"
        }
      ]
    },
    "sit_stage": {
      "type": "event",
      "events": [
        {
          "op": "rover_sit"
        }
      ],
      "wait_stage": "seated",
      "next": "name_prompt"
    },
    "name_prompt": {
      "type": "event",
      "events": [
        {
          "op": "prompt_name"
        }
      ],
      "next": "name_react"
    },
    "name_react": {
      "type": "line",
      "text": "Hrmm… Well… Hrmmm…\n{player}…\nNow THAT is an odd name.\nMya ha ha ha howr!",
      "next": "name_react_2",
      "events": [
        {
          "op": "manpu",
          "name": "smile_d1"
        }
      ]
    },
    "name_react_2": {
      "type": "line",
      "text": "Not that my opinion means\nmuch. What matters is, do\nYOU like the name\n{player}?",
      "next": "gender_ask",
      "events": [
        {
          "op": "manpu",
          "name": "reset_sit"
        }
      ]
    },
    "gender_ask": {
      "type": "choice",
      "options": [
        {
          "text": "Isn't it cool?",
          "goto": "gender_confirm_boy"
        },
        {
          "text": "Isn't it cute?",
          "goto": "gender_confirm_girl"
        },
        {
          "text": "No! No! No!",
          "goto": "name_again"
        }
      ]
    },
    "name_again": {
      "type": "line",
      "text": "Huh? What was that? I think\nmaybe I heard you wrong.",
      "next": "name_again_2",
      "events": [
        {
          "op": "manpu",
          "name": "niko_d1"
        }
      ]
    },
    "name_again_2": {
      "type": "line",
      "text": "How about you go ahead and\ntell me again?",
      "next": "name_prompt"
    },
    "gender_confirm_boy": {
      "type": "line",
      "text": "Oh, I'm sorry! Did I say it\nwas odd? It's not odd!\nIt's a great name for a boy!\nReally. It's uh…",
      "next": "gender_confirm_boy_2"
    },
    "gender_confirm_boy_2": {
      "type": "line",
      "text": "It's a really great name.\nMya ha ha ha ha ha howr!",
      "next": "gender_boy_choice",
      "events": [
        {
          "op": "manpu",
          "name": "smile_d1"
        }
      ]
    },
    "gender_boy_choice": {
      "type": "choice",
      "options": [
        {
          "text": "You know it!",
          "goto": "town_ask",
          "events": [
            {
              "op": "set_var",
              "name": "gender",
              "value": "male"
            }
          ]
        },
        {
          "text": "I'm not a boy!",
          "goto": "gender_oops_girl",
          "events": [
            {
              "op": "set_var",
              "name": "gender",
              "value": "female"
            }
          ]
        }
      ]
    },
    "gender_confirm_girl": {
      "type": "line",
      "text": "You're right! Of course!\nWhat was I thinking?\nI think it's a very cute name\nfor a very cute girl.",
      "next": "gender_confirm_girl_2"
    },
    "gender_confirm_girl_2": {
      "type": "line",
      "text": "I, uh, I'm sorry I said\nit sounded funny. Honestly!",
      "next": "gender_girl_choice"
    },
    "gender_girl_choice": {
      "type": "choice",
      "options": [
        {
          "text": "I forgive you.",
          "goto": "town_ask",
          "events": [
            {
              "op": "set_var",
              "name": "gender",
              "value": "female"
            }
          ]
        },
        {
          "text": "I'm not a girl!",
          "goto": "gender_oops",
          "events": [
            {
              "op": "set_var",
              "name": "gender",
              "value": "male"
            }
          ]
        }
      ]
    },
    "gender_oops_girl": {
      "type": "line",
      "text": "Oh, whoops! You're a girl?",
      "next": "gender_oops_girl_2",
      "events": [
        {
          "op": "manpu",
          "name": "ha_d1"
        }
      ]
    },
    "gender_oops_girl_2": {
      "type": "line",
      "text": "Hrmm… How embarrassing…\nYup. Real awkward…\nHey, I oughta apologize!",
      "next": "town_ask"
    },
    "gender_oops": {
      "type": "line",
      "text": "What? You're a boy?!?",
      "next": "gender_oops_2",
      "events": [
        {
          "op": "manpu",
          "name": "ha_d1"
        }
      ]
    },
    "gender_oops_2": {
      "type": "line",
      "text": "Oh, man, my bad! Seriously!\nLet me get my paw out of my\nmouth, here. Now I see…",
      "next": "town_ask"
    },
    "town_ask": {
      "type": "line",
      "text": "By the way…if you don't mind\nme asking…where are you\nheaded?",
      "next": "town_prompt"
    },
    "town_prompt": {
      "type": "event",
      "events": [
        {
          "op": "prompt_town"
        }
      ],
      "next": "town_confirm"
    },
    "town_confirm": {
      "type": "line",
      "text": "You're going to\n{town}?",
      "next": "town_confirm_choice"
    },
    "town_confirm_choice": {
      "type": "choice",
      "options": [
        {
          "text": "That's right!",
          "goto": "town_ok"
        },
        {
          "text": "You're wrong!",
          "goto": "town_wrong"
        }
      ]
    },
    "town_wrong": {
      "type": "line",
      "text": "Huh? What was that? I think\nmaybe I heard you wrong.",
      "next": "town_wrong_2"
    },
    "town_wrong_2": {
      "type": "line",
      "text": "How about you go ahead and\ntell me again?",
      "next": "town_prompt"
    },
    "town_ok": {
      "type": "line",
      "text": "Hey! I know that place!\n{town} is one of\nmy favorite vacation spots!",
      "next": "q2"
    },
    "q2": {
      "type": "line",
      "text": "So, what are you going to\n{town} for?",
      "next": "q2_choice"
    },
    "q2_choice": {
      "type": "choice",
      "options": [
        {
          "text": "I'm moving.",
          "goto": "q2_moving",
          "events": [
            {
              "op": "or_var",
              "name": "answer_flags",
              "mask": 4
            }
          ]
        },
        {
          "text": "What's it to ya?",
          "goto": "q2_rude"
        }
      ]
    },
    "q2_moving": {
      "type": "line",
      "text": "Hrmm… Moving, huh?\nI hate moving. Pack boxes,\nunpack boxes. It never ends.\nSay! Where's your new place?",
      "next": "q3_choice"
    },
    "q2_rude": {
      "type": "line",
      "text": "Fine, don't tell me!\nBe like that! I don't care!",
      "next": "q2_rude_2",
      "events": [
        {
          "op": "manpu",
          "name": "musu_d1"
        }
      ]
    },
    "q2_rude_2": {
      "type": "line",
      "text": "I know you're moving, though.\nI can see it in your eyes!",
      "next": "q2_rude_3",
      "events": [
        {
          "op": "manpu",
          "name": "hate_d1"
        }
      ]
    },
    "q2_rude_3": {
      "type": "line",
      "text": "So, where are you going to\nbe living, huh?",
      "next": "q3_choice",
      "events": [
        {
          "op": "manpu",
          "name": "reset_sit"
        }
      ]
    },
    "q3_choice": {
      "type": "choice",
      "options": [
        {
          "text": "Don't know yet.",
          "goto": "q3_unknown",
          "events": [
            {
              "op": "or_var",
              "name": "answer_flags",
              "mask": 2
            }
          ]
        },
        {
          "text": "Leave me alone!",
          "goto": "q3_alone"
        }
      ]
    },
    "q3_unknown": {
      "type": "line",
      "text": "What?!? You don't know yet?\nAre you out of your tree?\nWell, we obviously need to\nfind you a place to live!!!",
      "next": "phone_lead",
      "events": [
        {
          "op": "manpu",
          "name": "gaaan_d1"
        }
      ]
    },
    "q3_alone": {
      "type": "line",
      "text": "Don't… Don't tell me…\nYou haven't found a place to\nlive yet?!? Mya ha howr!\nOf course you have! Who…",
      "next": "q3_alone_2",
      "events": [
        {
          "op": "manpu",
          "name": "smile_d1"
        }
      ]
    },
    "q3_alone_2": {
      "type": "line",
      "text": "WHAAAT?!? You haven't?!?\nYou can't just show up with\nno place to live! We'd better\nfind you a pad, and fast!",
      "next": "phone_lead_alone",
      "events": [
        {
          "op": "manpu",
          "name": "gaaan_d1"
        }
      ]
    },
    "phone_lead": {
      "type": "line",
      "text": "…Oh, wait! Boy, am I dense!\nThis buddy of mine runs the\nshop in {town}!\nLet me give him a jingle!",
      "next": "phone_lead_2",
      "events": [
        {
          "op": "manpu",
          "name": "hirameki_d1"
        }
      ]
    },
    "phone_lead_2": {
      "type": "line",
      "text": "This'll take me two seconds.\nWait right here, OK?",
      "next": "phone_stage",
      "events": [
        {
          "op": "manpu",
          "name": "reset_sit"
        }
      ]
    },
    "phone_lead_alone": {
      "type": "line",
      "text": "…Oh! Of course! Duh!\nA good friend of mine runs\nthe shop in {town}.\nLet me give him a ring!",
      "next": "phone_lead_alone_2",
      "events": [
        {
          "op": "manpu",
          "name": "hirameki_d1"
        }
      ]
    },
    "phone_lead_alone_2": {
      "type": "line",
      "text": "You wait right here!",
      "next": "phone_stage",
      "events": [
        {
          "op": "manpu",
          "name": "reset_sit"
        }
      ]
    },
    "phone_stage": {
      "type": "event",
      "events": [
        {
          "op": "rover_phone"
        }
      ],
      "wait_stage": "keitai_talk",
      "next": "phone_call"
    },
    "phone_call": {
      "type": "line",
      "text": "{c:150,150,150}{s:20}Beep Beep Boop Beep!\n…\nHey there, Nook! …It's me!{s:32}",
      "next": "phone_call2"
    },
    "phone_call2": {
      "type": "line",
      "text": "{c:150,150,150}{s:20}So, what's the good word?\nYou raking in the cash?\n…Uh-huh… Yeah.\nOoh, that's rough! Brutal!{s:32}",
      "next": "phone_call3"
    },
    "phone_call3": {
      "type": "line",
      "text": "{c:150,150,150}{s:20}Well, it's a crazy world!\nAnyway, as I was saying,\nI have someone here who\nwants to move to {town}…{s:32}",
      "next": "phone_call4"
    },
    "phone_call4": {
      "type": "line",
      "text": "{c:150,150,150}{s:20}Oh, yeah, completely!\nBut the poor thing still hasn't\nfound a place to live.\nIt's sort of a tight spot…{s:32}",
      "next": "phone_call5"
    },
    "phone_call5": {
      "type": "line",
      "text": "{c:150,150,150}{s:20}…The kid's name? Why? …Oh.\nIt's {player}.\n…Umm, yeah. Yeah, today.\nSo, think you can help out?{s:32}",
      "next": "phone_call6"
    },
    "phone_call6": {
      "type": "line",
      "text": "{c:150,150,150}{s:20}…Oh? Oh, really?\n…Uh-huh… I see.\nOh, OK! Cool!\n…Yeah, I'll pass the word on.{s:32}",
      "next": "phone_call7"
    },
    "phone_call7": {
      "type": "line",
      "text": "{c:150,150,150}{s:20}…So we'll catch up later.\nRiiight. Thanks a lot.\nSee ya, Nook, my man!\nBye!{s:32}",
      "next": "phone_done_stage"
    },
    "phone_done_stage": {
      "type": "event",
      "events": [
        {
          "op": "rover_phone_done"
        }
      ],
      "wait_stage": "return_approach",
      "next": "phone_done"
    },
    "phone_done": {
      "type": "line",
      "text": "OK, I'm back! Miss me? Mya!",
      "next": "return_sit_stage"
    },
    "return_sit_stage": {
      "type": "event",
      "events": [
        {
          "op": "rover_return"
        }
      ],
      "wait_stage": "return_seated",
      "next": "phone_done_2"
    },
    "phone_done_2": {
      "type": "line",
      "text": "Well, good news for you!\nIt sounds like my buddy has\nsome brand-new houses\nfor sale, dirt cheap!",
      "next": "phone_done_3"
    },
    "phone_done_3": {
      "type": "line",
      "text": "The work's all done, but he\nhasn't been able to rent them.",
      "next": "phone_done_4"
    },
    "phone_done_4": {
      "type": "line",
      "text": "He wants to unload them, so\nhe's willing to take a loss.",
      "next": "q4"
    },
    "q4": {
      "type": "line",
      "text": "You have money, right?",
      "next": "q4_choice"
    },
    "q4_choice": {
      "type": "choice",
      "options": [
        {
          "text": "Oh, yeah!",
          "goto": "farewell_rich"
        },
        {
          "text": "Just a little…",
          "goto": "farewell_poor",
          "events": [
            {
              "op": "or_var",
              "name": "answer_flags",
              "mask": 1
            }
          ]
        }
      ]
    },
    "farewell_rich": {
      "type": "line",
      "text": "Then you'll be just fine!",
      "next": "farewell_rich_2",
      "events": [
        {
          "op": "manpu",
          "name": "niko_d1"
        }
      ]
    },
    "farewell_rich_2": {
      "type": "line",
      "text": "Wow…a brand-new house!\nNothing like it in the world!\nMaybe I'll move in, too…",
      "next": "farewell_rich_3"
    },
    "farewell_rich_3": {
      "type": "line",
      "text": "Oh! Looks like we're about\nto pull into {town}.\nMan, I love this place!",
      "next": "farewell",
      "events": [
        {
          "op": "manpu",
          "name": "ha_d1"
        }
      ]
    },
    "farewell_poor": {
      "type": "line",
      "text": "Oh, really? No wonder you\nlook so helpless.",
      "next": "farewell_poor_1b",
      "events": [
        {
          "op": "manpu",
          "name": "komari_d1"
        }
      ]
    },
    "farewell_poor_1b": {
      "type": "line",
      "text": "But don't worry! These things\nhave a way of working out!",
      "next": "farewell_poor_2"
    },
    "farewell_poor_2": {
      "type": "line",
      "text": "Oh! Looks like we're about to\npull into {town}. Did\nI mention I love this place?",
      "next": "farewell_poor_3",
      "events": [
        {
          "op": "manpu",
          "name": "ha_d1"
        }
      ]
    },
    "farewell_poor_3": {
      "type": "line",
      "text": "Remember, things are never as\nbad as they seem. Honestly!\nGood luck and all that!",
      "next": "farewell"
    },
    "farewell": {
      "type": "line",
      "text": "Anyway, maybe we'll run into\neach other again sometime!\nGood-bye! And good luck!",
      "next": "finish",
      "events": [
        {
          "op": "manpu",
          "name": "reset_sit"
        }
      ]
    },
    "finish": {
      "type": "event",
      "events": [
        {
          "op": "resolve_face"
        },
        {
          "op": "finish_intro"
        }
      ],
      "next": ""
    }
  }
}
