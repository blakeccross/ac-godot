{
  "id": "rover_intro",
  "speaker_id": "rover",
  "start": "greet",
  "nodes": {
    "greet": {
      "type": "line",
      "text": "Hrmm… Uh… Excuse me…",
      "next": "greet_2"
    },
    "greet_2": {
      "type": "line",
      "text": "Do you have a second? Could you help me out?",
      "next": "greet_clock"
    },
    "greet_clock": {
      "type": "line",
      "text": "Is it… Let's see now… {hour}:{minute} on {weekday}, {month}/{day}/{year}?",
      "next": "clock_choice"
    },
    "clock_choice": {
      "type": "choice",
      "options": [
        {
          "text": "That's right!",
          "goto": "clock_ok"
        },
        {
          "text": "Nope!",
          "goto": "clock_wrong"
        }
      ]
    },
    "clock_wrong": {
      "type": "line",
      "text": "Whaaat? It's not? Well, do you think you could straighten this out for me?",
      "next": "clock_prompt",
      "events": [
        {
          "op": "manpu",
          "name": "gaaan1"
        }
      ]
    },
    "clock_prompt": {
      "type": "event",
      "events": [
        {
          "op": "prompt_clock"
        }
      ],
      "next": "clock_confirm"
    },
    "clock_confirm": {
      "type": "line",
      "text": "Now, let me get this straight. You say it's {hour}:{minute} on {weekday}, {month}/{day}/{year}?",
      "next": "clock_confirm_choice"
    },
    "clock_confirm_choice": {
      "type": "choice",
      "options": [
        {
          "text": "That's right!",
          "goto": "clock_ok"
        },
        {
          "text": "Nope!",
          "goto": "clock_reject"
        }
      ]
    },
    "clock_reject": {
      "type": "line",
      "text": "What? I think I heard you wrong. Tell me once more.",
      "next": "clock_prompt",
      "events": [
        {
          "op": "manpu",
          "name": "hate1"
        }
      ]
    },
    "clock_ok": {
      "type": "line",
      "text": "Say, thanks! You're too kind!",
      "next": "clock_ok_2",
      "events": [
        {
          "op": "manpu",
          "name": "smile1"
        }
      ]
    },
    "clock_ok_2": {
      "type": "line",
      "text": "Really, you're a big help… Mya ha ha ha ha howr!",
      "next": "greet_sit",
      "events": [
        {
          "op": "manpu",
          "name": "smile1"
        }
      ]
    },
    "greet_sit": {
      "type": "line",
      "text": "So, mind if I sit here?",
      "next": "greet_sit_2"
    },
    "greet_sit_2": {
      "type": "line",
      "text": "I promise I won't fall asleep, tumble onto you, and start drooling on your shirt!",
      "next": "greet_choice"
    },
    "greet_choice": {
      "type": "choice",
      "options": [
        {
          "text": "Please!",
          "goto": "sit_yes",
          "events": [
            {
              "op": "or_var",
              "name": "answer_flags",
              "mask": 8
            }
          ]
        },
        {
          "text": "No way!",
          "goto": "sit_no"
        }
      ]
    },
    "sit_yes": {
      "type": "line",
      "text": "Thanks again! It sure is nice meeting friendly folk on the train…",
      "next": "sit_yes_2"
    },
    "sit_yes_2": {
      "type": "line",
      "text": "You aren't a psycho, right? Just kidding!",
      "next": "sit_stage"
    },
    "sit_no": {
      "type": "line",
      "text": "Wow, it's nice to know there are still plenty of rude people in the world.",
      "next": "sit_no_2",
      "events": [
        {
          "op": "manpu",
          "name": "niko_d1"
        }
      ]
    },
    "sit_no_2": {
      "type": "line",
      "text": "Know what? I'm going to sit here anyway.",
      "next": "sit_stage",
      "events": [
        {
          "op": "manpu",
          "name": "reset_sit"
        }
      ]
    },
    "sit_stage": {
      "type": "event",
      "events": [
        {
          "op": "rover_sit"
        }
      ],
      "wait_stage": "seated",
      "next": "sit_ok"
    },
    "sit_ok": {
      "type": "line",
      "text": "So what's your name?",
      "next": "name_prompt"
    },
    "name_prompt": {
      "type": "event",
      "events": [
        {
          "op": "prompt_name"
        }
      ],
      "next": "name_react"
    },
    "name_react": {
      "type": "line",
      "text": "Hrmm… Well… Hrmmm… {player}…",
      "next": "name_react_2"
    },
    "name_react_2": {
      "type": "line",
      "text": "Now THAT is an odd name. Mya ha ha ha howr!",
      "next": "name_react_3",
      "events": [
        {
          "op": "manpu",
          "name": "smile_d1"
        }
      ]
    },
    "name_react_3": {
      "type": "line",
      "text": "Not that my opinion means much. What matters is, do YOU like the name {player}?",
      "next": "gender_ask",
      "events": [
        {
          "op": "manpu",
          "name": "reset_sit"
        }
      ]
    },
    "gender_ask": {
      "type": "choice",
      "options": [
        {
          "text": "Cool, yeah.",
          "goto": "gender_confirm_boy"
        },
        {
          "text": "It's cute, actually.",
          "goto": "gender_confirm_girl"
        },
        {
          "text": "That's not right.",
          "goto": "name_again"
        }
      ]
    },
    "name_again": {
      "type": "line",
      "text": "Huh? I think maybe I heard you wrong.",
      "next": "name_again_2",
      "events": [
        {
          "op": "manpu",
          "name": "niko_d1"
        }
      ]
    },
    "name_again_2": {
      "type": "line",
      "text": "How about you go ahead and tell me again? What's your name?",
      "next": "name_prompt",
      "events": [
        {
          "op": "manpu",
          "name": "reset_sit"
        }
      ]
    },
    "gender_confirm_boy": {
      "type": "line",
      "text": "Oh, I'm sorry! Did I say it was odd?",
      "next": "gender_confirm_boy_2"
    },
    "gender_confirm_boy_2": {
      "type": "line",
      "text": "It's not odd! It's a great name for a boy! Really. Mya ha ha ha ha ha howr!",
      "next": "gender_boy_choice",
      "events": [
        {
          "op": "manpu",
          "name": "smile_d1"
        }
      ]
    },
    "gender_boy_choice": {
      "type": "choice",
      "options": [
        {
          "text": "That's right.",
          "goto": "town_ask",
          "events": [
            {
              "op": "set_var",
              "name": "gender",
              "value": "male"
            }
          ]
        },
        {
          "text": "I'm not a boy.",
          "goto": "gender_oops_girl",
          "events": [
            {
              "op": "set_var",
              "name": "gender",
              "value": "female"
            }
          ]
        }
      ]
    },
    "gender_confirm_girl": {
      "type": "line",
      "text": "You're right! Of course! What was I thinking?",
      "next": "gender_confirm_girl_2"
    },
    "gender_confirm_girl_2": {
      "type": "line",
      "text": "I think it's a very cute name for a very cute girl. I'm sorry I said it sounded funny!",
      "next": "gender_girl_choice"
    },
    "gender_girl_choice": {
      "type": "choice",
      "options": [
        {
          "text": "That's right.",
          "goto": "town_ask",
          "events": [
            {
              "op": "set_var",
              "name": "gender",
              "value": "female"
            }
          ]
        },
        {
          "text": "I'm not a girl.",
          "goto": "gender_oops",
          "events": [
            {
              "op": "set_var",
              "name": "gender",
              "value": "male"
            }
          ]
        }
      ]
    },
    "gender_oops_girl": {
      "type": "line",
      "text": "Oh, whoops! You're a girl? Hrmm… How embarrassing…",
      "next": "gender_oops_girl_2",
      "events": [
        {
          "op": "manpu",
          "name": "ha_d1"
        }
      ]
    },
    "gender_oops_girl_2": {
      "type": "line",
      "text": "Yup. Real awkward… Hey, I oughta apologize!",
      "next": "town_ask"
    },
    "gender_oops": {
      "type": "line",
      "text": "What? You're a boy?! Oh, man, my bad! Seriously!",
      "next": "gender_oops_2",
      "events": [
        {
          "op": "manpu",
          "name": "ha_d1"
        }
      ]
    },
    "gender_oops_2": {
      "type": "line",
      "text": "Let me get my paw out of my mouth, here. Now I see…",
      "next": "town_ask"
    },
    "town_ask": {
      "type": "line",
      "text": "By the way… if you don't mind me asking… where are you headed?",
      "next": "town_prompt"
    },
    "town_prompt": {
      "type": "event",
      "events": [
        {
          "op": "prompt_town"
        }
      ],
      "next": "town_confirm"
    },
    "town_confirm": {
      "type": "line",
      "text": "You're going to {town}?",
      "next": "town_confirm_choice"
    },
    "town_confirm_choice": {
      "type": "choice",
      "options": [
        {
          "text": "That's right!",
          "goto": "town_ok"
        },
        {
          "text": "Wrong town.",
          "goto": "town_wrong"
        }
      ]
    },
    "town_wrong": {
      "type": "line",
      "text": "Huh? I think maybe I heard you wrong. How about you tell me again?",
      "next": "town_prompt"
    },
    "town_ok": {
      "type": "line",
      "text": "Hey! I know that place! {town} is one of my favorite vacation spots!",
      "next": "q2"
    },
    "q2": {
      "type": "line",
      "text": "So, tell me, why are you going to {town}?",
      "next": "q2_choice"
    },
    "q2_choice": {
      "type": "choice",
      "options": [
        {
          "text": "I'm moving.",
          "goto": "q2_moving",
          "events": [
            {
              "op": "or_var",
              "name": "answer_flags",
              "mask": 4
            }
          ]
        },
        {
          "text": "What's it to ya?",
          "goto": "q2_rude"
        }
      ]
    },
    "q2_moving": {
      "type": "line",
      "text": "Hrmm… Moving, huh? I hate moving. Pack boxes, unpack boxes… It never ends.",
      "next": "q3"
    },
    "q2_rude": {
      "type": "line",
      "text": "Fine, don't tell me! Be like that! I don't care!",
      "next": "q2_rude_2",
      "events": [
        {
          "op": "manpu",
          "name": "musu_d1"
        }
      ]
    },
    "q2_rude_2": {
      "type": "line",
      "text": "I know you're moving, though. I can see it in your eyes!",
      "next": "q3",
      "events": [
        {
          "op": "manpu",
          "name": "hate_d1"
        }
      ]
    },
    "q3": {
      "type": "line",
      "text": "So where are you going to be living?",
      "next": "q3_choice",
      "events": [
        {
          "op": "manpu",
          "name": "reset_sit"
        }
      ]
    },
    "q3_choice": {
      "type": "choice",
      "options": [
        {
          "text": "Don't know yet.",
          "goto": "q3_unknown",
          "events": [
            {
              "op": "or_var",
              "name": "answer_flags",
              "mask": 2
            }
          ]
        },
        {
          "text": "Leave me alone!",
          "goto": "q3_alone"
        }
      ]
    },
    "q3_unknown": {
      "type": "line",
      "text": "What?! You don't know yet? Are you out of your tree?",
      "next": "phone_lead",
      "events": [
        {
          "op": "manpu",
          "name": "gaaan_d1"
        }
      ]
    },
    "q3_alone": {
      "type": "line",
      "text": "Don't tell me… You haven't found a place to live yet?!",
      "next": "q3_alone_2",
      "events": [
        {
          "op": "manpu",
          "name": "smile_d1"
        }
      ]
    },
    "q3_alone_2": {
      "type": "line",
      "text": "Mya ha howr! Of course you have! Who… WHAAAT?! You haven't?!",
      "next": "phone_lead",
      "events": [
        {
          "op": "manpu",
          "name": "gaaan_d1"
        }
      ]
    },
    "phone_lead": {
      "type": "line",
      "text": "Well, we obviously need to find you a place to live!!!",
      "next": "phone_lead_2",
      "events": [
        {
          "op": "manpu",
          "name": "reset_sit"
        }
      ]
    },
    "phone_lead_2": {
      "type": "line",
      "text": "…Oh, I know! This buddy of mine runs a shop in {town}…",
      "next": "phone_lead_3",
      "events": [
        {
          "op": "manpu",
          "name": "hirameki_d1"
        }
      ]
    },
    "phone_lead_3": {
      "type": "line",
      "text": "I'll give him a call. It'll only take two seconds, OK?",
      "next": "phone_stage",
      "events": [
        {
          "op": "manpu",
          "name": "reset_sit"
        }
      ]
    },
    "phone_stage": {
      "type": "event",
      "events": [
        {
          "op": "rover_phone"
        }
      ],
      "wait_stage": "keitai_talk",
      "next": "phone_call"
    },
    "phone_call": {
      "type": "line",
      "text": "…Beep, beep, boop, beep!",
      "next": "phone_call2"
    },
    "phone_call2": {
      "type": "line",
      "text": "…Hey there, Nook! It's me! So what's the good word?",
      "next": "phone_call3"
    },
    "phone_call3": {
      "type": "line",
      "text": "…I've got someone here who wants to move to {town} — {player}, to be exact.",
      "next": "phone_call4"
    },
    "phone_call4": {
      "type": "line",
      "text": "…Still needs a place to live. Think you can help out?",
      "next": "phone_call5"
    },
    "phone_call5": {
      "type": "line",
      "text": "…Oh, really? Cool! …Yeah, I'll pass the word on. Thanks a lot. See ya, Nook! Bye!",
      "next": "phone_done_stage"
    },
    "phone_done_stage": {
      "type": "event",
      "events": [
        {
          "op": "rover_phone_done"
        },
        {
          "op": "rover_return"
        }
      ],
      "wait_stage": "return_approach",
      "next": "phone_done"
    },
    "phone_done": {
      "type": "line",
      "text": "OK, I'm back! Miss me? Mya!",
      "next": "phone_done_2"
    },
    "phone_done_2": {
      "type": "line",
      "text": "Good news — my buddy has some brand-new houses for sale, dirt cheap!",
      "next": "q4"
    },
    "q4": {
      "type": "line",
      "text": "You have money, right?",
      "next": "q4_choice"
    },
    "q4_choice": {
      "type": "choice",
      "options": [
        {
          "text": "Oh, yeah!",
          "goto": "farewell_rich"
        },
        {
          "text": "Just a little…",
          "goto": "farewell_poor",
          "events": [
            {
              "op": "or_var",
              "name": "answer_flags",
              "mask": 1
            }
          ]
        }
      ]
    },
    "farewell_rich": {
      "type": "line",
      "text": "Then you'll be just fine! Wow… a brand-new house! Nothing like it in the world!",
      "next": "farewell_rich_2",
      "events": [
        {
          "op": "manpu",
          "name": "niko_d1"
        }
      ]
    },
    "farewell_rich_2": {
      "type": "line",
      "text": "Oh! Looks like we're about to pull into {town}. Man, I love this place!",
      "next": "farewell",
      "events": [
        {
          "op": "manpu",
          "name": "ha_d1"
        }
      ]
    },
    "farewell_poor": {
      "type": "line",
      "text": "Oh, really? No wonder you look so helpless. But don't worry!",
      "next": "farewell_poor_2",
      "events": [
        {
          "op": "manpu",
          "name": "komari_d1"
        }
      ]
    },
    "farewell_poor_2": {
      "type": "line",
      "text": "These things have a way of working out! Oh! Looks like we're pulling into {town}.",
      "next": "farewell",
      "events": [
        {
          "op": "manpu",
          "name": "ha_d1"
        }
      ]
    },
    "farewell": {
      "type": "line",
      "text": "Maybe we'll run into each other again sometime.",
      "next": "farewell_2",
      "events": [
        {
          "op": "manpu",
          "name": "reset_sit"
        }
      ]
    },
    "farewell_2": {
      "type": "line",
      "text": "Well, good-bye! And good luck!",
      "next": "finish"
    },
    "finish": {
      "type": "event",
      "events": [
        {
          "op": "resolve_face"
        },
        {
          "op": "finish_intro"
        }
      ],
      "next": ""
    }
  }
}
