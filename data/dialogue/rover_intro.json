{
  "id": "rover_intro",
  "speaker_id": "rover",
  "start": "greet",
  "nodes": {
    "greet": {
      "type": "line",
      "text": "Hrmm… Uh… Excuse me… Do you have a second? Could you help me out?",
      "next": "greet_sit"
    },
    "greet_sit": {
      "type": "line",
      "text": "Mind if I sit here? I promise I won't fall asleep, tumble onto you, and start drooling on your shirt!",
      "next": "greet_choice"
    },
    "greet_choice": {
      "type": "choice",
      "options": [
        { "text": "Please!", "goto": "clock_ask" },
        { "text": "No way!", "goto": "clock_ask" }
      ]
    },
    "clock_ask": {
      "type": "line",
      "text": "Is it… Let's see now… {hour}:{minute} on {weekday}, {month}/{day}/{year}?",
      "next": "clock_choice"
    },
    "clock_choice": {
      "type": "choice",
      "options": [
        { "text": "That's right!", "goto": "sit_stage" },
        { "text": "Nope!", "goto": "clock_prompt" }
      ]
    },
    "clock_prompt": {
      "type": "event",
      "events": [{ "op": "prompt_clock" }],
      "next": "clock_confirm"
    },
    "clock_confirm": {
      "type": "line",
      "text": "Is it… Let's see now… {hour}:{minute} on {weekday}, {month}/{day}/{year}?",
      "next": "clock_confirm_choice"
    },
    "clock_confirm_choice": {
      "type": "choice",
      "options": [
        { "text": "That's right!", "goto": "sit_stage" },
        { "text": "Nope!", "goto": "clock_prompt" }
      ]
    },
    "sit_stage": {
      "type": "event",
      "events": [{ "op": "rover_sit" }],
      "next": "sit_ok"
    },
    "sit_ok": {
      "type": "line",
      "text": "So what's your name?",
      "next": "name_prompt"
    },
    "name_prompt": {
      "type": "event",
      "events": [{ "op": "prompt_name" }],
      "next": "name_react"
    },
    "name_react": {
      "type": "line",
      "text": "{player}, huh? That's a cool name!",
      "next": "gender_ask"
    },
    "gender_ask": {
      "type": "choice",
      "options": [
        { "text": "Cool, yeah.", "goto": "gender_confirm_boy" },
        { "text": "It's cute, actually.", "goto": "gender_confirm_girl" },
        { "text": "That's not right.", "goto": "name_again" }
      ]
    },
    "name_again": {
      "type": "line",
      "text": "Whoops — let's try that again. What's your name?",
      "next": "name_prompt"
    },
    "gender_confirm_boy": {
      "type": "line",
      "text": "So you're a boy, then?",
      "next": "gender_boy_choice"
    },
    "gender_boy_choice": {
      "type": "choice",
      "options": [
        {
          "text": "That's right.",
          "goto": "town_ask",
          "events": [{ "op": "set_var", "name": "gender", "value": "male" }]
        },
        {
          "text": "I'm not a boy.",
          "goto": "town_ask",
          "events": [{ "op": "set_var", "name": "gender", "value": "female" }]
        }
      ]
    },
    "gender_confirm_girl": {
      "type": "line",
      "text": "So you're a girl, then?",
      "next": "gender_girl_choice"
    },
    "gender_girl_choice": {
      "type": "choice",
      "options": [
        {
          "text": "That's right.",
          "goto": "town_ask",
          "events": [{ "op": "set_var", "name": "gender", "value": "female" }]
        },
        {
          "text": "I'm not a girl.",
          "goto": "gender_oops",
          "events": [{ "op": "set_var", "name": "gender", "value": "male" }]
        }
      ]
    },
    "gender_oops": {
      "type": "line",
      "text": "Ha — got it. Boy it is. Moving on!",
      "next": "town_ask"
    },
    "town_ask": {
      "type": "line",
      "text": "Where are you headed, {player}?",
      "next": "town_prompt"
    },
    "town_prompt": {
      "type": "event",
      "events": [{ "op": "prompt_town" }],
      "next": "town_confirm"
    },
    "town_confirm": {
      "type": "line",
      "text": "You're going to {town}?",
      "next": "town_confirm_choice"
    },
    "town_confirm_choice": {
      "type": "choice",
      "options": [
        { "text": "That's right!", "goto": "q2" },
        { "text": "Wrong town.", "goto": "town_prompt" }
      ]
    },
    "q2": {
      "type": "line",
      "text": "So, tell me, why are you going to {town}?",
      "next": "q2_choice"
    },
    "q2_choice": {
      "type": "choice",
      "options": [
        {
          "text": "I'm moving.",
          "goto": "q3",
          "events": [{ "op": "or_var", "name": "answer_flags", "mask": 8 }]
        },
        { "text": "What's it to ya?", "goto": "q3" }
      ]
    },
    "q3": {
      "type": "line",
      "text": "So where are you going to be living?",
      "next": "q3_choice"
    },
    "q3_choice": {
      "type": "choice",
      "options": [
        {
          "text": "Don't know yet.",
          "goto": "q4",
          "events": [{ "op": "or_var", "name": "answer_flags", "mask": 4 }]
        },
        { "text": "Leave me alone!", "goto": "q4" }
      ]
    },
    "q4": {
      "type": "line",
      "text": "You have money, right?",
      "next": "q4_choice"
    },
    "q4_choice": {
      "type": "choice",
      "options": [
        { "text": "Oh, yeah!", "goto": "phone_stage" },
        {
          "text": "Just a little…",
          "goto": "phone_stage",
          "events": [{ "op": "or_var", "name": "answer_flags", "mask": 1 }]
        }
      ]
    },
    "phone_stage": {
      "type": "event",
      "events": [{ "op": "rover_phone" }, { "op": "resolve_face" }],
      "next": "phone_lead"
    },
    "phone_lead": {
      "type": "line",
      "text": "Well, we obviously need to find you a place to live!!! …Oh, I know! This buddy of mine runs a shop in {town}… I'll give him a call. It'll only take two seconds, OK?",
      "next": "phone_call"
    },
    "phone_call": {
      "type": "line",
      "text": "…Hey, it's me. Got a new neighbor for you — {player}, heading to {town}. Got a spare house?",
      "next": "phone_call2"
    },
    "phone_call2": {
      "type": "line",
      "text": "…He'll meet you at the station. Don't leave him hanging.",
      "next": "phone_done_stage"
    },
    "phone_done_stage": {
      "type": "event",
      "events": [{ "op": "rover_phone_done" }, { "op": "rover_return" }],
      "next": "phone_done"
    },
    "phone_done": {
      "type": "line",
      "text": "All set. When we stop, look for the raccoon in the apron — he'll sort you out.",
      "next": "farewell"
    },
    "farewell": {
      "type": "line",
      "text": "Well, good-bye! Maybe we'll run into each other again sometime. Next stop: {town}!",
      "next": "finish"
    },
    "finish": {
      "type": "event",
      "events": [{ "op": "finish_intro" }],
      "next": ""
    }
  }
}
