{
  "id": "post_girl_greeting",
  "speaker_id": "post_girl",
  "start": "start",
  "nodes": {
    "start": {
      "type": "line",
      "text": "Welcome!\nHow can I help you?",
      "next": "menu"
    },
    "menu": {
      "type": "choice",
      "options": [
        { "text": "Mail a letter", "goto": "mail" },
        { "text": "Send fossils to the Farway Museum", "goto": "farway" },
        { "text": "Make a deposit", "goto": "deposit" },
        { "text": "Save a letter", "goto": "save" },
        { "text": "Never mind...", "goto": "bye" }
      ]
    },
    "mail": {
      "type": "line",
      "text": "Yes, I see... one moment."
    },
    "farway": {
      "type": "line",
      "text": "Fossils for the Farway\nMuseum? Of course. Let's\nsee what you've got."
    },
    "deposit": {
      "type": "line",
      "text": "You want to deposit some\nmoney?"
    },
    "save": {
      "type": "line",
      "text": "Well, then, tell me how you'd\nlike to save."
    },
    "bye": {
      "type": "line",
      "text": "Oh, really? Come back\nanytime."
    }
  }
}
