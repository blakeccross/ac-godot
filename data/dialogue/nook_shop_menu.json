{
  "id": "nook_shop_menu",
  "speaker_id": "tom_nook",
  "start": "start",
  "nodes": {
    "start": {
      "type": "branch",
      "when": [
        {
          "if": {
            "var_eq": {
              "name": "shop_balloon",
              "value": "yes"
            }
          },
          "goto": "balloon"
        },
        {
          "if": {
            "var_eq": {
              "name": "shop_again",
              "value": "yes"
            }
          },
          "goto": "again"
        },
        {
          "goto": "welcome"
        }
      ]
    },
    "welcome": {
      "type": "line",
      "text": "Hello, hello! Welcome to\n{free0}! What can I do\nfor you today?",
      "next": "menu"
    },
    "again": {
      "type": "line",
      "text": "Yes, yes? Was there\nsomething else?",
      "next": "menu"
    },
    "balloon": {
      "type": "line",
      "text": "It's our big sale today!\nHere, take this {item0}\nas a thank-you gift!",
      "next": "menu"
    },
    "menu": {
      "type": "choice",
      "prompt": "What can I do for you?",
      "options": [
        {
          "text": "I want to sell.",
          "goto": "sell"
        },
        {
          "text": "Order from the catalog.",
          "goto": "order"
        },
        {
          "text": "Other things.",
          "goto": "other"
        },
        {
          "text": "Never mind.",
          "goto": "bye"
        }
      ]
    },
    "sell": {
      "type": "event",
      "events": [
        {
          "op": "nook_shop",
          "action": "sell"
        }
      ],
      "next": "sell_line"
    },
    "sell_line": {
      "type": "line",
      "text": "Oh-ho! Let's see what\nyou've got for me."
    },
    "order": {
      "type": "event",
      "events": [
        {
          "op": "nook_shop",
          "action": "order"
        }
      ],
      "next": "order_branch"
    },
    "order_branch": {
      "type": "branch",
      "when": [
        {
          "if": {
            "var_eq": {
              "name": "shop_order",
              "value": "full"
            }
          },
          "goto": "order_full"
        },
        {
          "goto": "order_line"
        }
      ]
    },
    "order_line": {
      "type": "line",
      "text": "This is your very own\ncatalog, yes? Just pick\nwhatever you'd like to order!"
    },
    "order_full": {
      "type": "line",
      "text": "Hm, you already have five\norders on the way. Let's wait\nuntil those arrive, shall we?",
      "next": "menu"
    },
    "other": {
      "type": "choice",
      "prompt": "As far as other things go,\nthis is all I have to offer.",
      "options": [
        {
          "text": "Turnip prices?",
          "goto": "turnip_branch"
        },
        {
          "text": "Hear code",
          "goto": "code_hear"
        },
        {
          "text": "Say code",
          "goto": "code_say"
        },
        {
          "text": "Umm, hang on!",
          "goto": "menu"
        }
      ]
    },
    "turnip_branch": {
      "type": "branch",
      "when": [
        {
          "if": {
            "var_eq": {
              "name": "shop_sunday",
              "value": "yes"
            }
          },
          "goto": "turnip_sunday"
        },
        {
          "goto": "turnip_price"
        }
      ]
    },
    "turnip_price": {
      "type": "line",
      "text": "Today I'm buying turnips\nat {free1} Bells apiece.\nBring me as many as you like!",
      "next": "menu"
    },
    "turnip_sunday": {
      "type": "line",
      "text": "I don't buy turnips on\nSundays. That's when Joan\ncomes by to sell them!",
      "next": "menu"
    },
    "bye": {
      "type": "line",
      "text": "Please come again!"
    },
    "code_hear": {
      "type": "event",
      "events": [
        {
          "op": "nook_shop",
          "action": "code_hear"
        }
      ],
      "next": "code_hear_branch"
    },
    "code_hear_branch": {
      "type": "branch",
      "when": [
        {
          "if": {
            "var_eq": {
              "name": "shop_code",
              "value": "none"
            }
          },
          "goto": "code_hear_none"
        },
        {
          "goto": "code_hear_ask"
        }
      ]
    },
    "code_hear_none": {
      "type": "line",
      "text": "But you don't have anything\nI could make a password for.\nPlease try again later.",
      "next": "menu"
    },
    "code_hear_ask": {
      "type": "line",
      "text": "OK. Now just tell me the\ntown name and player name of\nthe person this password is for."
    },
    "code_say": {
      "type": "event",
      "events": [
        {
          "op": "nook_shop",
          "action": "code_say"
        }
      ],
      "next": "code_say_branch"
    },
    "code_say_branch": {
      "type": "branch",
      "when": [
        {
          "if": {
            "var_eq": {
              "name": "shop_code",
              "value": "foreign"
            }
          },
          "goto": "code_say_foreign"
        },
        {
          "if": {
            "var_eq": {
              "name": "shop_code",
              "value": "out"
            }
          },
          "goto": "code_say_out"
        },
        {
          "if": {
            "var_eq": {
              "name": "shop_code",
              "value": "full"
            }
          },
          "goto": "code_say_full"
        },
        {
          "goto": "code_say_ask"
        }
      ]
    },
    "code_say_foreign": {
      "type": "line",
      "text": "I'm terribly sorry, but you\nhave to pick up presents at\nthe shop in your own town.",
      "next": "menu"
    },
    "code_say_out": {
      "type": "line",
      "text": "Hmm... I don't have any more\npresents to hand out for\npasswords. Please come back later.",
      "next": "menu"
    },
    "code_say_full": {
      "type": "line",
      "text": "But you can't carry anything\nelse. Come back after you\nclean out your pockets.",
      "next": "menu"
    },
    "code_say_ask": {
      "type": "line",
      "text": "Then tell me the password."
    }
  }
}
