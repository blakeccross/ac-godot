{
  "id": "post_girl_deposit",
  "speaker_id": "post_girl",
  "start": "ask",
  "nodes": {
    "ask": {
      "type": "choice",
      "prompt": "How much will you deposit?",
      "options": [
        {
          "text": "All bells",
          "goto": "done",
          "events": [{ "op": "deposit_bells", "amount": -1 }]
        },
        {
          "text": "1,000 bells",
          "goto": "done",
          "events": [{ "op": "deposit_bells", "amount": 1000 }]
        },
        { "text": "Never mind...", "goto": "cancel" }
      ]
    },
    "done": {
      "type": "line",
      "text": "All set! Your savings are safe with us."
    },
    "cancel": {
      "type": "line",
      "text": "Oh, really? Come back\nanytime."
    }
  }
}
