[gd_scene format=3]

[node name="Letter" type="Button"]
custom_minimum_size = Vector2(0, 88)
size_flags_horizontal = 3
focus_mode = 0
mouse_filter = 1
toggle_mode = true

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = 10.0
offset_right = -16.0
offset_bottom = -10.0
mouse_filter = 2
theme_override_constants/separation = 4
alignment = 1

[node name="Name" type="Label" parent="Content"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 22
text = "Empty"
text_overrun_behavior = 3

[node name="Detail" type="Label" parent="Content"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 16
text = "Tap to write"
text_overrun_behavior = 3
