[node name="Sequence" type="AnimationPlayer" parent="."]
unique_name_in_owner = true
editor_description = "`ac_animal_logo`, in 60 Hz ticks. `in`: the three logo clips run 240 ticks (`cKF_SkeletonInfo_R_init` frames 1–121 at speed 0.5), then the backdrop fades in at 20/255 a tick, reaching 220/255 on tick 11 and moving on at tick 12 (`aAL_back_fadein`'s strict `> 220`). `hold`: `aAL_TIMER` 60 ticks with the TM mark up, START ignored. `pulse`: `aAL_game_start_wait`, the phase turning 32768/50 s16 a tick on the bright half and 32768/22 on the dim. `start`: `aAL_FADEOUT_TIMER` 26 ticks of solid PRESS START with the chime, then start_selected."
libraries = {
&"": SubResource("AnimationLibrary_logo")
}

