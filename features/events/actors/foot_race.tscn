[gd_scene format=3]

[ext_resource type="Script" path="res://features/events/foot_race.gd" id="1"]

[node name="FootRace" type="Node"]
script = ExtResource("1")

[node name="PhaseTimer" type="Timer" parent="."]
editor_description = "`aTKC_*`: the warm-up (240 frames at 30 fps), the line-up (115) and the goal (600); FootRace starts it with each phase's time."
one_shot = true

[connection signal="timeout" from="PhaseTimer" to="." method="_on_phase_timer_timeout"]
