[gd_scene format=3]

[ext_resource type="Script" path="res://features/intro/title.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/world/world.tscn" id="2"]
[ext_resource type="PackedScene" path="res://features/intro/title_logo.tscn" id="3"]
[ext_resource type="PackedScene" path="res://scenes/world/station_porter.tscn" id="4_porter"]
[ext_resource type="PackedScene" path="res://scenes/ui/settings_overlay.tscn" id="5"]

[node name="Title" type="Node"]
script = ExtResource("1")

[node name="World" parent="." instance=ExtResource("2")]
unique_name_in_owner = true

[node name="Porter" parent="." instance=ExtResource("4_porter")]
unique_name_in_owner = true

[node name="TitleLogo" parent="." instance=ExtResource("3")]
unique_name_in_owner = true

[node name="Menu" type="CanvasLayer" parent="."]
unique_name_in_owner = true
layer = 6
visible = false

[node name="Fade" type="ColorRect" parent="Menu"]
unique_name_in_owner = true
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0, 0, 0, 0)

[node name="Center" type="CenterContainer" parent="Menu"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Menu/Center"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Slot0Button" type="Button" parent="Menu/Center/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(360, 64)
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Empty"
autowrap_mode = 2

[node name="Slot1Button" type="Button" parent="Menu/Center/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(360, 64)
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Empty"
autowrap_mode = 2

[node name="Slot2Button" type="Button" parent="Menu/Center/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(360, 64)
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Empty"
autowrap_mode = 2

[node name="Slot3Button" type="Button" parent="Menu/Center/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(360, 64)
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Empty"
autowrap_mode = 2

[node name="ImportButton" type="Button" parent="Menu/Center/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(360, 44)
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Import GameCube Save"

[node name="SettingsButton" type="Button" parent="Menu/Center/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(360, 44)
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Settings"

[node name="ImportFileDialog" type="FileDialog" parent="Menu"]
unique_name_in_owner = true
title = "Import a GameCube Save"
size = Vector2i(760, 500)
ok_button_text = "Open"
file_mode = 0
access = 2
filters = PackedStringArray("*.gci ; Dolphin save export", "*.raw ; GameCube save image")
use_native_dialog = true

[node name="ImportConfirm" type="ConfirmationDialog" parent="Menu"]
unique_name_in_owner = true
title = "Replace Town?"
ok_button_text = "Replace"
dialog_autowrap = true

[node name="SettingsOverlay" parent="." instance=ExtResource("5")]

[connection signal="pressed" from="Menu/Center/VBox/Slot0Button" to="." method="_on_slot_pressed" binds= [0]]
[connection signal="pressed" from="Menu/Center/VBox/Slot1Button" to="." method="_on_slot_pressed" binds= [1]]
[connection signal="pressed" from="Menu/Center/VBox/Slot2Button" to="." method="_on_slot_pressed" binds= [2]]
[connection signal="pressed" from="Menu/Center/VBox/Slot3Button" to="." method="_on_slot_pressed" binds= [3]]
[connection signal="pressed" from="Menu/Center/VBox/ImportButton" to="." method="_on_import_pressed"]
[connection signal="pressed" from="Menu/Center/VBox/SettingsButton" to="." method="_on_settings_pressed"]
[connection signal="file_selected" from="Menu/ImportFileDialog" to="." method="_on_import_file_selected"]
[connection signal="confirmed" from="Menu/ImportConfirm" to="." method="_on_import_confirmed"]
